<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --green:#9BC83A;--green-dim:#7ea82e;--green-glow:rgba(155,200,58,0.18);
  --dark:#1C1C1C;--dark-mid:#242424;--dark-light:#2e2e2e;
  --white:#FFFFFF;--offwhite:#E8E8E8;--muted:#888;--muted-light:#AAAAAA;
  --red:#EE3124;--border:rgba(155,200,58,0.25);--border-subtle:rgba(255,255,255,0.08);
}
html{scroll-behavior:smooth}
body{background:var(--dark);color:var(--white);font-family:Arial,"Noto Sans TC",sans-serif;font-size:15px;line-height:1.6;overflow-x:hidden}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0.9rem 2rem;display:flex;align-items:center;justify-content:space-between;background:rgba(28,28,28,0.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--border-subtle)}
.nav-logo{display:flex;align-items:center;gap:0.6rem;font-size:0.65rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--white)}
.nav-taitra-logo{height:30px;width:auto}
.nav-divider{width:1px;height:20px;background:rgba(255,255,255,0.15);flex-shrink:0}
nav a{color:var(--green);text-decoration:none;font-size:0.65rem;font-weight:700}

/* ── HERO ── */
.hero{min-height:88vh;position:relative;overflow:hidden;background:var(--dark);display:flex;align-items:center;padding-top:60px}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 20%, rgba(155,200,58,0.08) 0%, transparent 50%);pointer-events:none}
.hero-inner{position:relative;z-index:2;max-width:1100px;margin:0 auto;padding:4rem 2rem;width:100%;text-align:center}
.hero-content{max-width:700px;margin:0 auto;opacity:0;animation:fade-up 0.9s ease 0.15s forwards}
@keyframes fade-up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.hero-eyebrow{display:inline-flex;align-items:center;gap:0.5rem;margin-bottom:1.2rem;font-size:0.62rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--green);background:rgba(155,200,58,0.1);padding:0.35rem 0.9rem;border-radius:20px}
.hero-eyebrow::before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--red);flex-shrink:0}
.hero h1{font-size:clamp(2rem,6vw,3.2rem);font-weight:700;line-height:1.15;letter-spacing:-0.015em;margin-bottom:1rem;color:var(--white)}
.hero h1 em{font-style:normal;color:var(--green)}
.hero-sub{font-size:0.95rem;color:var(--muted-light);line-height:1.7;margin-bottom:2.5rem;max-width:580px;margin-left:auto;margin-right:auto}
.tour-buttons{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:0.8rem;margin-bottom:1rem}
.tour-btn{background:transparent;border:1px solid var(--green);color:var(--green);font-size:0.7rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:0.75rem 1.2rem;border-radius:3px;cursor:pointer;transition:background .2s,color .2s,transform .15s;white-space:nowrap}
.tour-btn:hover{background:var(--green);color:var(--dark);transform:translateY(-2px)}
.tour-btn:active{transform:translateY(0)}

/* ── DIVIDER ── */
.divider{width:100%;height:1px;background:linear-gradient(90deg,transparent,rgba(155,200,58,0.3),transparent)}

/* ── SECTION SHARED ── */
.section{padding:5rem 2rem}
.section-inner{max-width:1100px;margin:0 auto}
.section-header{margin-bottom:2.5rem;opacity:0;animation:fade-up 0.8s ease forwards}
.section-eyebrow{display:inline-flex;align-items:center;gap:0.5rem;margin-bottom:0.6rem;font-size:0.62rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--green)}
.section-eyebrow::before{content:"";display:inline-block;width:16px;height:2px;background:var(--green)}
.section-title{font-size:clamp(1.5rem,4vw,2.2rem);font-weight:700;line-height:1.2;letter-spacing:-0.01em;margin-bottom:0.8rem;color:var(--white)}
.section-desc{font-size:0.9rem;color:var(--muted-light);line-height:1.75;max-width:650px}

/* ── TOUR SECTIONS ── */
#robotics{background:var(--dark)}
#ai{background:var(--dark-mid)}
#motion{background:var(--dark)}
#rugged{background:var(--dark-mid)}
#connected{background:var(--dark)}
#integrated{background:var(--dark-mid)}
#modernization{background:var(--dark)}

.company-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.2rem;margin-top:1.8rem;opacity:0;animation:fade-up 0.8s ease 0.1s forwards}
.company-card{background:var(--dark-light);border:1px solid var(--border);border-radius:4px;padding:1.6rem;transition:border-color .2s,background .2s}
.company-card:hover{border-color:var(--green);background:rgba(155,200,58,0.05)}
.company-name{font-size:0.9rem;font-weight:700;color:var(--green);letter-spacing:0.05em;margin-bottom:0.6rem;text-transform:uppercase}
.company-desc{font-size:0.85rem;color:var(--muted-light);line-height:1.6}

/* ── BACK TO TOP ── */
.back-to-top{display:flex;justify-content:center;margin-top:3rem;opacity:0;animation:fade-up 0.8s ease 0.2s forwards}
.back-to-top a{background:transparent;color:var(--green);border:1px solid var(--green);padding:0.7rem 1.8rem;border-radius:3px;font-size:0.7rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;text-decoration:none;transition:background .2s,color .2s,transform .15s}
.back-to-top a:hover{background:var(--green);color:var(--dark);transform:translateY(-2px)}

/* ── FOOTER ── */
footer{background:var(--dark-mid);border-top:1px solid var(--border-subtle);padding:3rem 2rem;margin-top:3rem}
.footer-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:start}
.footer-info{display:flex;align-items:center;gap:0.8rem;margin-bottom:2rem}
.footer-taitra{height:28px;width:auto}
.footer-brand-text{font-size:0.65rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted-light)}
.footer-brand-text strong{color:var(--green)}
.footer-booth{font-size:0.8rem;color:var(--muted-light);line-height:1.6;margin-bottom:2rem}
.social-links{display:flex;gap:1.2rem;flex-wrap:wrap}
.social-link{cursor:pointer;transition:opacity .2s;}
.social-link:hover{opacity:0.75}
.footer-cta{text-align:right}
.footer-cta a{display:inline-block;background:var(--green);color:var(--dark);padding:0.75rem 1.6rem;border-radius:3px;font-size:0.7rem;font-weight:700;letter-spacing:0.07em;text-transform:uppercase;text-decoration:none;margin-top:0.5rem;transition:background .2s}
.footer-cta a:hover{background:var(--green-dim)}

/* ── REVEAL ── */
.reveal{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
.reveal.visible{opacity:1;transform:translateY(0)}

/* ── RESPONSIVE ── */
@media(max-width:768px){
  nav{padding:0.8rem 1.5rem}
  .nav-logo{font-size:0.58rem}
  .nav-taitra-logo{height:26px}
  .hero{min-height:78vh;padding-top:50px}
  .hero-inner{padding:3rem 1.5rem}
  .tour-buttons{grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0.6rem}
  .section{padding:3.5rem 1.5rem}
  .company-grid{grid-template-columns:1fr}
  .footer-inner{grid-template-columns:1fr;gap:2rem}
  .footer-cta{text-align:left}
  .social-link svg{width:54px;height:54px}
